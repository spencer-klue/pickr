{
  "manifest_version": 3,
  "name": "Pickr Wall",
  "version": "0.5.0",
  "description": "Tiles your own logged-in college football streams into a video wall and lets the Pickr board swap the lead game and audio.",
  "permissions": [
    "scripting",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8787/*",
        "http://127.0.0.1:8787/*",
        "https://*.github.io/*",
        "https://*.netlify.app/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.foxsports.com/*",
        "*://*.espn.com/*",
        "*://plus.espn.com/*",
        "*://*.abc.com/*",
        "*://*.nbc.com/*",
        "*://*.peacocktv.com/*",
        "*://*.paramountplus.com/*",
        "*://*.cbssports.com/*",
        "*://*.tntdrama.com/*",
        "*://*.tbs.com/*",
        "*://*.trutv.com/*",
        "*://*.cwtv.com/*",
        "*://*.usanetwork.com/*",
        "*://*.cnbc.com/*",
        "*://*.xfinity.com/*",
        "*://*.mwc.tv/*",
        "*://*.uconnplus.com/*"
      ],
      "js": [
        "theater.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "*://*.foxsports.com/*",
    "*://*.espn.com/*",
    "*://plus.espn.com/*",
    "*://*.abc.com/*",
    "*://*.nbc.com/*",
    "*://*.peacocktv.com/*",
    "*://*.paramountplus.com/*",
    "*://*.cbssports.com/*",
    "*://*.tntdrama.com/*",
    "*://*.tbs.com/*",
    "*://*.trutv.com/*",
    "*://*.cwtv.com/*",
    "*://*.usanetwork.com/*",
    "*://*.cnbc.com/*",
    "*://*.xfinity.com/*",
    "*://*.mwc.tv/*",
    "*://*.uconnplus.com/*"
  ]
}